{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kitsuvo": {
      "type": "streamable-http",
      "url": "https://kitsuvo-mcp-relay.fly.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://kitsuvo-mcp-relay.fly.dev/mcp",
            "baseScopes": [
              "browser"
            ]
          }
        }
      }
    }
  }
}
