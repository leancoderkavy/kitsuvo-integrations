{
  "manifest_version": 3,
  "name": "Kitsuvo \u2014 see how sites were built",
  "version": "0.1.0",
  "description": "Check local AI-builder fingerprints and optionally filter builder-hosted search results. No account, cloud AI, or telemetry.",
  "homepage_url": "https://kitsuvo.com/extensions",
  "icons": {
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Kitsuvo page evidence",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://www.google.com/search*",
    "https://www.bing.com/search*",
    "https://duckduckgo.com/*",
    "https://html.duckduckgo.com/*",
    "https://lite.duckduckgo.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "background": {
    "scripts": [
      "rules.js",
      "detector.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-evidence@kitsuvo.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
